{
  "name": "claude-config-manager",
  "version": "0.1.5",
  "description": "Claude Code API 配置管理工具，支持多个 API 配置的集中管理和快速切换",
  "main": "dist/index.js",
  "bin": {
    "ccm": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "tsx scripts/generate-version.ts",
    "build": "npm run prebuild && tsc",
    "dev": "npm run prebuild && tsc --watch",
    "start": "node dist/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "api",
    "config",
    "manager",
    "cli",
    "configuration",
    "api-management",
    "anthropic"
  ],
  "author": "yangtuooc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangtuooc/claude-config-manager.git"
  },
  "bugs": {
    "url": "https://github.com/yangtuooc/claude-config-manager/issues"
  },
  "homepage": "https://github.com/yangtuooc/claude-config-manager#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^11.0.0",
    "inquirer": "^8.2.5"
  }
}
